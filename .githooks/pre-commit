#!/bin/sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running engine pre-commit checks..."

# 1. Swift format lint
swift format lint --strict --recursive Sources Tests

# 2. SwiftLint
if command -v swiftlint >/dev/null 2>&1; then
  swiftlint lint --strict
fi

# 3. Swift build & index store generation (0 warnings enforced via -warnings-as-errors)
swift build --build-tests -Xswiftc -index-store-path -Xswiftc "$REPO_ROOT/.build/out"

# 4. Periphery unused code analysis
if command -v periphery >/dev/null 2>&1; then
  echo "Running Periphery unused code analysis..."
  periphery scan --index-store-path "$REPO_ROOT/.build/out" --skip-build
fi

# 5. Swift test unit suite
swift test

# 5. Kit-TS checks
(
  cd "$REPO_ROOT/kit-ts"
  npx biome ci
  npx tsc --noEmit
  npm run knip
  npm test
)

echo "✓ Pre-commit checks passed."
